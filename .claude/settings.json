{
  "$comment": [
    "A ROUTINE RUN NEVER YIELDS. Run No.61 stopped mid-phase on a permission",
    "prompt for an ordinary Write, and a stop is indistinguishable from asking",
    "a human who is not there. Everything this routine does every single run is",
    "allowlisted here so the run cannot be halted by its own plumbing.",
    "Scoped on purpose: nothing here allows a push, a merge, a send, a delete",
    "under runs/, or a write to a cron-written ledger."
  ],
  "permissions": {
    "allow": [
      "Write(out/**)",
      "Edit(out/**)",
      "Write(runs/**)",
      "Write(.claude/WORKLOG.md)",
